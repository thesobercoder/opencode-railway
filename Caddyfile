{
	admin off
	auto_https off
	servers {
		# Railway's edge reaches containers from CGNAT space.
		trusted_proxies static 100.64.0.0/10 fd00::/8
	}
}

:{$PORT} {
	# Railway probes without credentials. Forward its health check to the V2
	# API with basic auth so success verifies the server and its credential.
	handle /healthz {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:{$OPENCODE_INTERNAL_PORT} {
			header_up Authorization "{$OPENCODE_AUTH_HEADER}"
		}
	}

	handle {
		reverse_proxy 127.0.0.1:{$OPENCODE_INTERNAL_PORT} {
			# opencode streams server-sent events on /api/event; without this
			# Caddy buffers them and the UI never updates.
			flush_interval -1
		}
	}
}
